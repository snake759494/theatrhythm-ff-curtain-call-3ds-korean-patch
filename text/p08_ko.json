{
 "message/quest_message_jp.mdt": [
  "\u0002\u0001현재 \u0002\u0002진행 중인 퀘스트\u0002\u0001를 포기하고\n\u0002\u0002이 혼돈의 지도의 퀘스트\u0002\u0001를 시작하겠습니까?\n새 퀘스트를 시작하면\n\u0002\u0003진행 중인 퀘스트의 기록은 사라집니다\u0002\u0001.",
  "\u0002\u0001선택한 \u0002\u0002혼돈의 지도\u0002\u0001를 \u0002\u0003삭제\u0002\u0001하겠습니까?",
  "\u0002\u0001가지고 있는 \u0002\u0002혼돈의 지도\u0002\u0001가\n\u0002\u0003최대 수인 50장에 도달했습니다\u0002\u0001.\n필요 없는 \u0002\u0002지도\u0002\u0001를 \u0002\u0003삭제\u0002\u0001하면\n새 \u0002\u0002퀘스트\u0002\u0001 시작이 가능합니다.",
  "\u0002\u0002프로피카\u0002\u0001에 첨부할 \u0002\u0002혼돈의 지도\u0002\u0001를 선택하\n세요. 프로피카에는 \u0002\u0003클리어했고\n진행 중이 아닌 혼돈의 지도\u0002\u0001를 첨부할 수\n있습니다.",
  "\u0002\u0002혼돈의 지도\u0002\u0001를 \u0002\u0003정리\u0002\u0001합니다. 삭제할 혼돈의\n지도를 선택하여 \u0002\u0003삭제\u0002\u0001하세요.",
  "\u0002\u0002모험\u0002\u0001을 \u0002\u0003일시 중단\u0002\u0001하거나, 여기서\n모험을 \u0002\u0003포기하고 종료\u0002\u0001할 수 있습니다.",
  "\u0002\u0001정말 포기하겠습니까?",
  "\u0002\u0001이프리트의 모습이 새겨진\n\u0002\u0003육중한 문\u0002\u0001이 가로막고 있다.\n\u0002\u0002홍련 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001이프리트의 모습이 새겨진\n\u0002\u0003육중한 문\u0002\u0001이 가로막고 있다.\u0002\t\n\u0002\u0002칠흑 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001이프리트의 모습이 새겨진\n\u0002\u0003육중한 문\u0002\u0001이 가로막고 있어서\n이 앞의 \u0002\u0002칸\u0002\u0001으로는 \u0002\u0003갈 수 없습니다\u0002\u0001.",
  "\u0002\u0001시바의 모습이 새겨진\u0002\t\n\u0002\u0003장엄한 문\u0002\u0001이 가로막고 있다.\n\u0002\u0002빙정 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001시바의 모습이 새겨진\u0002\t\n\u0002\u0003장엄한 문\u0002\u0001이 가로막고 있다.\n\u0002\u0002칠흑 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001시바의 모습이 새겨진\n\u0002\u0003장엄한 문\u0002\u0001이 가로막고 있어서\n이 앞의 \u0002\u0002칸\u0002\u0001으로는 \u0002\u0003갈 수 없습니다\u0002\u0001.",
  "\u0002\u0001라무의 모습이 새겨진\u0002\t\n\u0002\u0003원숙한 문\u0002\u0001이 가로막고 있다.\n\u0002\u0002뇌명 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001라무의 모습이 새겨진\n\u0002\u0003원숙한 문\u0002\u0001이 가로막고 있다.\n\u0002\u0002칠흑 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001라무의 모습이 새겨진\n\u0002\u0003원숙한 문\u0002\u0001이 가로막고 있어서\n이 앞의 \u0002\u0002칸\u0002\u0001으로는 \u0002\u0003갈 수 없습니다\u0002\u0001.",
  "\u0002\u0001바하무트의 모습이 새겨진\n\u0002\u0003사악한 문\u0002\u0001이 가로막고 있다.\n\u0002\u0002칠흑 문장 열쇠\u0002\u0001를 쓰겠습니까?",
  "\u0002\u0001바하무트의 모습이 새겨진\u0002\t\n\u0002\u0003사악한 문\u0002\u0001이 가로막고 있어서\n이 앞의 \u0002\u0002칸\u0002\u0001으로는 \u0002\u0003갈 수 없습니다\u0002\u0001.",
  "\u0002\u0002에테라이트\u0002\u0001가 조용히 빛나고 있다…\n앞으로의 여정에서 \u0002\u0003모험에 실패했을 때\u0002\u0001,\n이 \u0002\u0002칸\u0002\u0001에서 \u0002\u0003퀘스트를 재개\u0002\u0001할 수 있습니다.",
  "\u0002\u0002빛의 커튼\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003받는 피해가\n경감\u0002\u0001됩니다.",
  "\u0002\u0002빛의 커튼\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002영웅의 약\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003받는 피해가\n경감\u0002\u0001됩니다.",
  "\u0002\u0002영웅의 약\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002거인의 약\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003전원의\nHP가 증가\u0002\u0001합니다.",
  "\u0002\u0002거인의 약\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002바커스의 술\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003전원의\n힘이 증가\u0002\u0001합니다.",
  "\u0002\u0002바커스의 술\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002현자의 지혜\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003전원의\n마력이 증가\u0002\u0001합니다.",
  "\u0002\u0002현자의 지혜\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002헤르메스의 신발\u0002\u0001 효과 발동.\n다음 스테이지에서 \u0002\u0003전원의\n민첩이 증가\u0002\u0001합니다.",
  "\u0002\u0002헤르메스의 신발\u0002\u0001 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002프로테스 드링크\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003전원의\n체력이 증가\u0002\u0001합니다.",
  "\u0002\u0002프로테스 드링크\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002성자의 마음\u0002\u0001의 효과가 발동.\n다음 스테이지에서 \u0002\u0003전원의\n정신이 증가\u0002\u0001합니다.",
  "\u0002\u0002성자의 마음\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002기사르의 피리\u0002\u0001의 효과가 발동.\n다음 칸에 \u0002\u0002뚱보 초코보\u0002\u0001를 불렀습니다.",
  "\u0002\u0001이미 이 \u0002\u0002혼돈의 지도\u0002\u0001에서는\u0002\t\n\u0002\u0002기사르의 피리\u0002\u0001를 사용했습니다.\n혼돈의 지도 하나당 \u0002\u00031회만\u0002\u0001\n기사르의 피리를 사용할 수 있습니다.",
  "\u0002\u0001다음 칸이 \u0002\u0002FMS 칸\u0002\u0001이 아니라서\n사용할 수 없었습니다.",
  "\u0002\u0001다음 \u0002\u0002칸\u0002\u0001에는 \u0002\u0003이미 이벤트가\n발생했기 때문에\u0002\u0001 사용할 수 없었습니다.",
  "\u0002\u0002알람\u0002\u0001의 효과가 발동.\n다음 칸에 \u0002\u0003흉악한 몬스터\u0002\u0001를 불렀습니다.",
  "\u0002\u0001이미 이 \u0002\u0002혼돈의 지도\u0002\u0001에서는\n\u0002\u0002알람\u0002\u0001을 사용했습니다.\n혼돈의 지도 하나당 \u0002\u00031회만\u0002\u0001\n알람을 사용할 수 있습니다.",
  "\u0002\u0001다음 칸이 \u0002\u0002BMS 칸\u0002\u0001이 아니라서\n사용할 수 없었습니다.",
  "\u0002\u0001다음 \u0002\u0002칸\u0002\u0001에는 \u0002\u0003이미 이벤트가\n발생했기 때문에\u0002\u0001 사용할 수 없었습니다.",
  "\u0002\u0002난쟁이의 빵\u0002\u0001의 효과가 발동.\n다음 \u0002\u0002칸\u0002\u0001의 \u0002\u0003상세 정보\u0002\u0001를 알았습니다.",
  "\u0002\u0001다음 \u0002\u0002칸\u0002\u0001은 이미 정보가 공개되어 있었습니다.",
  "\u0002\u0003다음 칸이 근처에 보이지 않아서\u0002\u0001\n사용할 수 없었습니다.",
  "\u0002\u0002텔레포 스톤\u0002\u0001의 효과가 발동.\n다음 칸 \u0002\u0003스테이지를 플레이하지 않고\u0002\u0001\n그 \u0002\u0002칸\u0002\u0001 위로 이동했습니다.",
  "\u0002\u0003다음에 이동할 칸의 후보가 여럿이라\u0002\u0001\n사용할 수 없었습니다.",
  "\u0002\u0003다음 칸 너머에 칸이 존재하지 않아서\u0002\u0001\n사용할 수 없었습니다.",
  "\u0002\u0002주얼 링\u0002\u0001의 효과가 발동.\n다음 스테이지의 획득 아이템 후보에\n\u0002\u0002크리스탈 조각\u0002\u0001이 추가되었습니다.",
  "\u0002\u0002주얼 링\u0002\u0001의 효과는 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002럭키 스피어\u0002\u0001의 효과가 발동.\n다음 칸의 \u0002\u0002악보 종류\u0002\u0001가 바뀌어\u0002\t\n\u0002\u0003난이도가 한 단계 내려갔습니다\u0002\u0001.",
  "\u0002\u0001다음 칸의 \u0002\u0002악보 종류\u0002\u0001는\n이미 \u0002\u0002기본 악보\u0002\u0001였습니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0003다음 칸이 근처에 보이지 않아서\u0002\u0001\n사용할 수 없었습니다.",
  "\u0002\u0001다음 칸에는 \u0002\u0002흉악한 몬스터\u0002\u0001가 있어서\u0002\t\n\u0002\u0002악보 종류\u0002\u0001를 바꿀 수 없었습니다.\n아이템도 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002승부사의 혼\u0002\u0001의 효과가 발동.\n다음 칸에서 모험할 \u0002\u0002악곡\u0002\u0001이\n\u0002\u0003다른 곡이 되었습니다\u0002\u0001.",
  "\u0002\u0003다음 칸이 근처에 보이지 않아서\u0002\u0001\n사용할 수 없었습니다.",
  "\u0002\u0002레벨다운 열매\u0002\u0001의 효과가 발동.\n이번 퀘스트에서 \u0002\u0002최종 보스\u0002\u0001를 쓰러뜨리면\u0002\t\n\u0002\u0003레벨 1 혼돈의 지도\u0002\u0001를 얻을 수 있습니다.",
  "\u0002\u0001이미 이 \u0002\u0002혼돈의 지도\u0002\u0001에서는\u0002\t\n\u0002\u0002레벨다운 열매\u0002\u0001를 사용했습니다.\u0002\t\n\u0002\u0001혼돈의 지도 하나당 \u0002\u00031회만\u0002\u0001\n레벨다운 열매를 사용할 수 있습니다.",
  "\u0002\u0002계승 퀘스트\u0002\u0001는 \u0002\u0002혼돈의 지도\u0002\u0001를 못 얻습니다.\n\u0002\u0002레벨다운 열매\u0002\u0001의 \u0002\u0003사용을 취소했습니다\u0002\u0001.",
  "\u0002\u0002스케이프고트\u0002\u0001의 효과가 발동.\n이번 퀘스트에서 게임 오버가 되었을 때\u0002\t\n\u0002\u0003HP 완전 회복 상태로 재개\u0002\u0001 가능합니다.",
  "\u0002\u0001이번 퀘스트에서 이미\n\u0002\u0002스케이프고트\u0002\u0001의 효과가 발동 중입니다.\n아이템은 \u0002\u0003사용하지 않았습니다\u0002\u0001.",
  "\u0002\u0002스케이프고트\u0002\u0001의 효과로\u0002\t\n\u0002\u0003HP 게이지 완전 회복 상태\u0002\u0001로\n모험을 재개했습니다."
 ],
